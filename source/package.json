{
  "name": "china-v2-mmorpg-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --base /group3/",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "vite build",
    "test": "node --import ./test-alias-loader.js --test"

  },
  "imports": {
    "@/*": "./src/*",
    "@app": "./src/app/index.js",
    "@app/*": "./src/app/*",
    "@shared/*": "./src/shared/*",
    "@components": "./src/shared/components/index.js",
    "@components/*": "./src/shared/components/*",
    "@features": "./src/shared/features/index.js",
    "@features/*": "./src/shared/features/*",
    "@surfaces/*": "./src/surfaces/*",
    "@lib": "./src/shared/lib/index.js",
    "@lib/*": "./src/shared/lib/*",
    "@hooks": "./src/shared/hooks/index.js",
    "@hooks/*": "./src/shared/hooks/*",
    "@services": "./src/shared/services/index.js",
    "@services/*": "./src/shared/services/*",
    "@assets/*": "./src/assets/*",
    "@styles/*": "./src/shared/styles/*"
  },

  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "gsap": "^3.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
